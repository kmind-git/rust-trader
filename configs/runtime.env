# Literal KEY=value entries; shell commands and expansion are not supported.
# Paths are relative to the installation root unless absolute.
REST_PORT=8080
RUST_LOG=info
APP_LOG_PATH=logs/app
APP_LOG_RETENTION_DAYS=14
FIX_LOG_RETENTION_DAYS=14
# Zero retention disables removal. Startup/shutdown deadlines are seconds.
START_TIMEOUT=15
STOP_TIMEOUT=15
