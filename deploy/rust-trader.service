# Generate with: ./traderctl systemd-unit (do not install this template directly)
[Unit]
Description=Rust Trader Exchange (FIX 4.2 acceptor + REST)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/traderctl" run
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
